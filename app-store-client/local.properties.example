# Local configuration - DO NOT COMMIT TO VERSION CONTROL
# Copy this file to local.properties and fill in your values

## Android SDK Location (auto-detected usually)
# sdk.dir=/path/to/Android/Sdk

## API Base URL for the backend server
# For emulator: http://10.0.2.2:3000/api/v1/
# For physical device: http://YOUR_COMPUTER_IP:3000/api/v1/
API_BASE_URL="http://10.0.2.2:3000/api/v1/"

## Keystore Configuration (for release builds)
# KEYSTORE_PASSWORD=your_keystore_password
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password

## Build Config Fields
# BUILD_TYPE=release